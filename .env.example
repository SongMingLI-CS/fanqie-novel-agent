# ---- DeepSeek 模型接入 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CA_BUNDLE=
DEEPSEEK_CONNECT_TIMEOUT=10
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=low

# ---- 生成与队列 ----
NOVEL_MAX_CHAPTER_TOKENS=6000
NOVEL_MAX_RETRIES=2
NOVEL_REQUEST_TIMEOUT=180
NOVEL_JOB_TIMEOUT=900
NOVEL_MAX_JOB_ATTEMPTS=3
NOVEL_WORKER_CONCURRENCY=1
NOVEL_WORKER_ONCE=false
# 多智能体写作流程（逗号分隔，可选 outline/chapter/polish）；留空 = 单次合成模式
NOVEL_AGENT_STAGES=outline,chapter
# 是否在 worker/服务重启后从中断的 Agent 节点继续（而非从头开始）
NOVEL_AUTO_RESUME=true
# 实时事件（SSE 进度/逐字流）在 events 表的保留天数，到期由服务启动时清理
NOVEL_EVENT_TTL_DAYS=7

# ---- 数据与导出 ----
NOVEL_DATA_DIR=./data
NOVEL_AUTO_EXPORT_TXT=true

# ---- 发布与审查 ----
NOVEL_AUTH_TOKEN=
NOVEL_PUBLISH_ENABLED=false
NOVEL_REQUIRE_REVIEW=true

# ---- 服务端监听与运维（.env 由 server/worker 启动时自动读取） ----
NOVEL_HOST=127.0.0.1
NOVEL_PORT=8787
# 日志级别与格式：text（人读）或 json（采集）；级别为 CRITICAL/ERROR/WARNING/INFO/DEBUG
NOVEL_LOG_LEVEL=INFO
NOVEL_LOG_FORMAT=text
# 显式指定 .env 文件路径；设为一个不存在的路径可完全禁用自动加载
NOVEL_ENV_FILE=
# 前端静态目录（默认依次回退：<repo>/static、<repo>/novel_agent/static）
NOVEL_STATIC_DIR=
